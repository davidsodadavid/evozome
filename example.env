# Copy this file to .env and fill in real values.

# Admin login password (plain text, only used locally to derive the hash below).
ADMIN_PASSWORD="changeme123"
# bcrypt hash of ADMIN_PASSWORD, generated by scripts/hash-password.mjs. This is what login actually checks.
# IMPORTANT: escape every "$" as "\$" here, otherwise Next.js's env variable
# interpolation will corrupt the hash (bcrypt hashes are full of literal "$").
ADMIN_PASSWORD_HASH="\$2b\$10\$replace-with-output-of-scripts-hash-password.mjs"
# Random secret used to sign the admin session cookie.
SESSION_SECRET="replace-with-a-long-random-string"

# Cloudflare R2 (S3-compatible object storage) — used for uploaded photos and videos.
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="your-bucket-name"
# Public base URL for the bucket (Public Development URL or a custom domain), no trailing slash.
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev"
